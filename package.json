{
  "name": "drawio-svg-optimizer-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3250",
    "build": "next build",
    "start": "npx serve out -l 3250",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "typecheck": "tsc --noEmit",
    "audit:bundle": "node scripts/audit-bundle.mjs",
    "deploy": "npm run build && npm run audit:bundle && wrangler deploy",
    "preview": "npm run build && wrangler dev"
  },
  "dependencies": {
    "@moriyoshi/drawio-svg-optimizer": "^0.1.1",
    "fflate": "^0.8.2",
    "next": "^16.2.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.131.1"
  }
}
